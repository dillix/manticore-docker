# Caddyfile — reverse proxy with automatic HTTPS in front of Manticore
# Search.
#
# All values come from environment variables defined in the .env file
# and exposed by docker-compose.yml; do not hardcode anything here.
#
# Caddy automatically:
#   - Obtains a Let's Encrypt certificate for {$MANTICORE_DOMAIN}
#   - Renews it before expiry
#   - Redirects HTTP -> HTTPS
#   - Listens on ports 80 (ACME + redirect) and 443 (HTTPS)

{$MANTICORE_DOMAIN} {
	tls {$MANTICORE_ACME_EMAIL}

	# Authentication is enforced by the Manticore engine itself (users,
	# passwords and bearer tokens — see `searchd_auth` in
	# docker-compose.yml), so this proxy holds no credentials and checks
	# none. It terminates TLS and forwards the Authorization header
	# through untouched, which is what lets the Drupal module
	# authenticate with HTTP Basic straight to the daemon.
	#
	# `manticore` is the service name from docker-compose.yml; Docker's
	# embedded DNS resolves it to the container's internal IP.
	reverse_proxy manticore:9308
}
