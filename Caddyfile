# Caddyfile — reverse proxy with automatic HTTPS and HTTP Basic Auth
# in front of Manticore Search.
#
# All values come from environment variables defined in the .env file
# and exposed by docker-compose.yml; do not hardcode anything here.
#
# Caddy automatically:
#   - Obtains a Let's Encrypt certificate for {$MANTICORE_DOMAIN}
#   - Renews it before expiry
#   - Redirects HTTP -> HTTPS
#   - Listens on ports 80 (ACME + redirect) and 443 (HTTPS)

{$MANTICORE_DOMAIN} {
	tls {$MANTICORE_ACME_EMAIL}

	# HTTP Basic Authentication. Username is in plaintext; the password
	# is a bcrypt hash (generated with `caddy hash-password`).
	# Manticore has no authentication of its own — this is the only
	# barrier between the public internet and the search daemon.
	basic_auth {
		{$MANTICORE_USERNAME} {$MANTICORE_PASSWORD_HASH}
	}

	# Forward all authenticated requests to Manticore's HTTP API.
	# `manticore` is the service name from docker-compose.yml; Docker's
	# embedded DNS resolves it to the container's internal IP.
	reverse_proxy manticore:9308
}
