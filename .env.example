# =============================================================================
# Manticore Search Docker Stack — environment configuration
# =============================================================================
# Copy this file to `.env` and adjust the values for your deployment.
# The .env file is loaded automatically by `docker compose`.
#
#   cp .env.example .env
#   nano .env
# =============================================================================


# -----------------------------------------------------------------------------
# Scenario A (single VPS, local only)
# -----------------------------------------------------------------------------
# No configuration is required. Just run:
#   docker compose up -d
# Manticore will listen on 127.0.0.1:9308 (HTTP) and 127.0.0.1:9306 (MySQL).


# -----------------------------------------------------------------------------
# Scenario B (two VPS, public HTTPS endpoint with Caddy)
# -----------------------------------------------------------------------------
# Required when starting the stack with `--profile public`.

# The fully-qualified domain that points to this VPS. Must have a public
# DNS A (and/or AAAA) record. Caddy will obtain a Let's Encrypt certificate
# for this domain on first start.
MANTICORE_DOMAIN=search.example.com

# Email address Let's Encrypt will use for expiry notices and recovery.
MANTICORE_ACME_EMAIL=admin@example.com

# HTTP Basic Auth username for the Drupal application to authenticate as.
MANTICORE_USERNAME=drupal

# Bcrypt hash of the password. NEVER put a plaintext password here.
# Generate one with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-strong-password'
# Copy the resulting string (starts with `$2a$` or `$2b$`) and paste it below.
# Note: in .env, you must escape every `$` as `$$` (Compose interpolates `$`).
MANTICORE_PASSWORD_HASH=
