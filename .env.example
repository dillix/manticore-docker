# =============================================================================
# Manticore Search Docker Stack — environment configuration
# =============================================================================
# Copy this file to `.env` and adjust the values for your deployment.
# The .env file is loaded automatically by `docker compose`.
#
# The easiest way to fill out this file is the interactive setup wizard:
#   docker compose run --rm -it config setup
#
# Or set individual values:
#   docker compose run --rm -it config domain   search.example.com
#   docker compose run --rm -it config email    admin@example.com
#   docker compose run --rm -it config username drupal
#   docker compose run --rm -it config password generate
#
# To inspect the current state at any time:
#   docker compose run --rm -it config show
# =============================================================================


# -----------------------------------------------------------------------------
# Scenario A (single VPS — local Drupal, or behind your own reverse proxy)
# -----------------------------------------------------------------------------
# No configuration is required. Just run:
#   docker compose up -d
# Manticore will listen on 127.0.0.1:9308 (HTTP) and 127.0.0.1:9306 (MySQL).


# -----------------------------------------------------------------------------
# Scenario B (dedicated Manticore VPS with bundled Caddy reverse proxy)
# -----------------------------------------------------------------------------
# Required when starting the stack with `--profile public`.

# The fully-qualified domain that points to this VPS. Must have a public
# DNS A (and/or AAAA) record. Caddy will obtain a Let's Encrypt certificate
# for this domain on first start.
MANTICORE_DOMAIN=search.example.com

# Email address Let's Encrypt will use for expiry notices and recovery.
MANTICORE_ACME_EMAIL=admin@example.com

# HTTP Basic Auth username for the Drupal application to authenticate as.
MANTICORE_USERNAME=drupal

# Bcrypt hash of the password. NEVER put a plaintext password here.
#
# The `config` helper writes this value with the required '$' escaping:
#   docker compose run --rm -it config password generate
#   docker compose run --rm -it config password change 'your-password'
#
# The hash appears as `$$2a$$...` or `$$2b$$...` in this file (every `$`
# doubled). Compose strips one `$` from each pair at runtime so that Caddy
# sees the correct single-`$` bcrypt hash. Do NOT edit by hand.
MANTICORE_PASSWORD_HASH=

